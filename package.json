{
  "name": "unscroll",
  "private": true,
  "version": "1.0.0",
  "description": "Practical knowledge in small daily sessions. An offline-first learning PWA.",
  "type": "module",
  "scripts": {
    "dev": "node --use-system-ca node_modules/vite/bin/vite.js",
    "build": "npm run assets && npm run typecheck && npm run validate:content && vite build",
    "assets": "node scripts/generate-assets.mjs",
    "typecheck": "tsc -b",
    "validate:content": "tsx scripts/validate-content.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "check:discovery": "node --use-system-ca --import tsx scripts/check-discovery.ts",
    "package": "npm run build && node scripts/package-release.mjs",
    "lint": "oxlint",
    "preview": "node --use-system-ca node_modules/vite/bin/vite.js preview"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@netlify/blobs": "^11.1.6",
    "@netlify/functions": "^6.0.3",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "archiver": "^8.0.0",
    "oxlint": "^1.88.0",
    "puppeteer-core": "^25.16.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
